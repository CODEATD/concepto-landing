# Copia este archivo a `.env` en local. En Netlify se definen en Site settings → Environment variables.

# Meta Pixel (público: se incrusta en el HTML). Vacío = el Pixel no se carga.
PUBLIC_META_PIXEL_ID=

# Token de la API de Conversiones de Meta (secreto: solo lo usa la Netlify Function).
META_CAPI_TOKEN=

# Opcional: código de prueba del Events Manager para validar eventos de CAPI.
META_CAPI_TEST_EVENT_CODE=
