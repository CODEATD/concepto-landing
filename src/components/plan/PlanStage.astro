  /* Tarjeta del plan: pulso amarillo cuando el cursor hace clic */
  .cardwrap {
    position: relative;
    z-index: 2;
    max-width: 480px;
    margin: 0 auto;
    border-radius: var(--r-card-lg);
  }
  .cardwrap::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: var(--r-card-lg);
    pointer-events: none;
    animation: cring 16s ease-out infinite;
  }
  @keyframes cring {
    0%,
    73% {
      box-shadow: 0 0 0 0 rgba(250, 217, 26, 0);
      border: 1px solid rgba(250, 217, 26, 0);
    }
    75% {
