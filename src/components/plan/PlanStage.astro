---
/**
 * Escena de la sección del plan. Los tiempos y keyframes se copian tal cual de la referencia.
 *
 * - >1100px: ciclo de 16s en bucle. Aparecen 5 mensajes de proveedores; un cursor viaja a la X de
 *   cada uno (kb1…kb5, xb1…xb5, cur, press, rip) y al final pulsa "¡LO QUIERO!" (cring).
 * - ≤1100px: al entrar en pantalla (una vez) se añade `.play`: 3 notificaciones salen deslizándose
 *   (swr/swl) y entra la tarjeta (cardin + cring1).
 *
 * El contenido de la tarjeta llega por <slot />.
 */
import { landing } from '@/data';
import Icon from '../ui/Icon.astro';
---

<div class="stage" data-plan-stage>
  <div class="ghostb ghostb--1" aria-hidden="true"></div>
  <div class="ghostb ghostb--2" aria-hidden="true"></div>

  {landing.providers.map(({ sender, before, amount, after }, i) => (
    <div class={`bub b${i + 1}`} aria-hidden="true">
      {/* PENDIENTE: foto de stock del proveedor; hoy es una silueta */}
      <span class="bub__avatar">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="#6E6E6E">
          <circle cx="12" cy="9" r="4.2" />
          <path d="M3.5 24c.6-5 4.1-8 8.5-8s7.9 3 8.5 8z" />
        </svg>
      </span>
      <div class="bub__body">
        <span class="bub__sender">{sender} · ahora</span>
        <p class="bub__text">
          {before}
          <strong>{amount}</strong>
          {after}
        </p>
      </div>
      <span class="x">
        <Icon name="close" size={10} strokeWidth={3} />
      </span>
    </div>
  ))}

  <div class="cur" aria-hidden="true">
    <span class="rip"></span>
    <svg width="26" height="30" viewBox="0 0 26 30">
      <path
        d="M2 2l0 22 6.2-5.6 4.1 9.2 4.2-1.9-4.1-9.1 8.6-.6z"
        fill="#FFFFFF"
        stroke="#000000"
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path>
    </svg>
  </div>

  <div class="cardwrap">
    <slot />
  </div>
</div>

<script>
  // Secuencia móvil: arranca una sola vez cuando la escena entra en pantalla.
  const stage = document.querySelector<HTMLElement>('[data-plan-stage]');
  if (stage) {
    if (!('IntersectionObserver' in window)) {
      stage.classList.add('play');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            stage.classList.add('play');
            io.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      io.observe(stage);
    }
  }
</script>

<style>
  .stage {
    position: relative;
    padding: 56px 0 64px;
    min-height: 680px;
    box-sizing: border-box;
  }

  /* ---------- Burbujas de proveedores ---------- */

