  .cur .rip {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 2px solid var(--yellow-500);
    opacity: 0;
    animation: rip 16s linear infinite;
  }
  @keyframes rip {
    0% {
      opacity: 0;
    }
    26.9% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.2);
    }
    27% {
      opacity: 0.7;
      transform: translate(-50%, -50%) scale(0.3);
    }
    29% {
      opacity: 0;
