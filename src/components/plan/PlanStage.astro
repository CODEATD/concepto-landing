    .cur,
    .ghostb,
    .bub .x,
    .b4,
    .b5 {
      display: none !important;
    }
    .cardwrap::after {
      animation: none;
    }
    .bub {
      z-index: 3;
      left: 0 !important;
      right: 0;
      margin: 0 auto;
      width: 100%;
      max-width: 420px;
      padding: 14px 16px;
      gap: 12px;
      border-radius: 20px;
      background: rgba(29, 29, 29, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 44px rgba(0, 0, 0, 0.55);
      animation: none !important;
      opacity: 1;
      filter: none;
      transform: none;
    }
    .bub__text {
      font-size: 14px;
      line-height: 20px;
    }
    .b1 {
      top: 8px;
    }
    .b2 {
      top: 116px;
    }
    .b3 {
      top: 224px;
    }
    .cardwrap {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
      filter: blur(8px);
    }
    .play .b1 {
      animation: swr 0.55s cubic-bezier(0.5, 0, 0.75, 0) 0.5s forwards !important;
    }
    .play .b2 {
      animation: swl 0.55s cubic-bezier(0.5, 0, 0.75, 0) 1.2s forwards !important;
    }
    .play .b3 {
      animation: swr 0.55s cubic-bezier(0.5, 0, 0.75, 0) 1.9s forwards !important;
    }
    .play .cardwrap {
      animation: cardin 0.8s var(--ease-out) 2.4s forwards;
    }
    .play .cardwrap::after {
      animation: cring1 1.2s ease-out 3.2s both;
    }
  }

  @media (max-width: 1100px) and (prefers-reduced-motion: reduce) {
    .bub {
      display: none !important;
    }
    .cardwrap {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>
