    }
    44.5% {
      transform: scale(1);
    }
    45% {
      transform: scale(0.82);
    }
    45.8% {
      transform: scale(1);
    }
    53.5% {
      transform: scale(1);
    }
    54% {
      transform: scale(0.82);
    }
    54.8% {
