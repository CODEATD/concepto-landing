---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { TeamMember } from '@/data';

type Props = TeamMember;

const { name, role, area, photo } = Astro.props;

// Fotos disponibles en src/assets/team, indexadas por nombre de archivo sin extensión.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/team/*.{webp,jpg,jpeg,png,avif}',
  { eager: true },
);
const byName = new Map(
  Object.entries(photos).map(([path, mod]) => [
    path
      .split('/')
      .pop()!
      .replace(/\.\w+$/, ''),
    mod.default,
  ]),
);

const image = photo ? byName.get(photo) : undefined;
if (photo && !image) {
  throw new Error(`TeamCard: no existe src/assets/team/${photo}.* para "${name}"`);
}
const initials = name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('');
---

<li class="member card">
  <div class="member__media">
    {image ? (
      <Picture
        src={image}
        alt={`${name}, ${role}`}
        width={220}
        height={250}
        widths={[220, 440, 660]}
        sizes="220px"
        formats={['avif', 'webp']}
        fit="cover"
        position="top"
        class="member__photo"
      />
    ) : (
      // PENDIENTE: foto del integrante
      <span class="member__placeholder" aria-hidden="true">
        {initials}
      </span>
    )}
    <span class="member__area">{area}</span>
  </div>
  <div class="member__info">
    <span class="member__name">{name}</span>
    <span class="member__role">{role}</span>
  </div>
</li>

<style>
  .member {
    flex: 0 0 220px;
    scroll-snap-align: start;
    border-radius: var(--r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .member__media {
    height: 250px;
    background: linear-gradient(180deg, var(--graphite-black), var(--ink-black));
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .member__media :global(picture),
  .member__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .member__photo {
    object-fit: cover;
    object-position: top;
  }
  .member__placeholder {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--medium-gray);
  }
  .member__area {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: var(--r-pill);
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--charcoal-gray);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--whisper-gray);
  }
  .member__info {
    padding: 14px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .member__name {
    font-size: 16px;
    line-height: 24px;
    font-weight: 600;
  }
  .member__role {
    font-size: 14px;
    line-height: 20px;
    color: var(--dusty-gray);
  }
</style>
