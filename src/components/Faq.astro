---
import { landing } from '@/data';
import Icon from './ui/Icon.astro';
---

<section class="faq" aria-labelledby="faq-title">
  <div class="faq__head rv">
    <span class="eyebrow">Preguntas frecuentes</span>
    <h2 id="faq-title" class="h2">
      Resolvemos <span class="silver serif">tus dudas</span>
    </h2>
  </div>

  <div class="faq__list" data-faq>
    {landing.faqs.map(({ q, a }, i) => {
      const open = i === 0;
      return (
        <div class:list={['faq-item rv', { 'is-open': open }]}>
          <h3 class="faq-item__q">
            <button
              class="faq-item__btn"
              type="button"
              aria-expanded={open ? 'true' : 'false'}
              aria-controls={`faq-a${i}`}
            >
              <span>{q}</span>
              <span class="faq-item__icon" aria-hidden="true">
                <Icon name="plus" size={14} strokeWidth={2.4} />
              </span>
            </button>
          </h3>
          <p id={`faq-a${i}`} class="faq-item__a fu" hidden={!open}>
            {a}
          </p>
        </div>
      );
    })}
  </div>
</section>

<script>
  // Acordeón: uno abierto a la vez.
  const list = document.querySelector<HTMLElement>('[data-faq]');
  const items = list ? [...list.querySelectorAll<HTMLElement>('.faq-item')] : [];

  for (const item of items) {
    item.querySelector('button')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const willOpen = button.getAttribute('aria-expanded') !== 'true';

      for (const other of items) {
        const open = other === item && willOpen;
        other.classList.toggle('is-open', open);
        other.querySelector('button')?.setAttribute('aria-expanded', String(open));
        const answer = other.querySelector<HTMLElement>('.faq-item__a');
        if (answer) answer.hidden = !open;
      }
    });
  }
</script>

<style>
  .faq {
    max-width: 820px;
    margin: 0 auto;
    padding: 56px var(--gutter);
  }
  .faq__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }
  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    border-radius: 18px;
    background: var(--jet-black);
    border: 1px solid var(--smoky-black);
    transition: border-color 0.25s ease;
  }
  .faq-item.is-open {
    border-color: var(--yellow-35);
  }
  .faq-item__q {
    margin: 0;
    font: inherit;
  }
  .faq-item__btn {
    width: 100%;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: none;
    border: 0;
    color: var(--white);
    font: inherit;
    font-size: 16px;
    line-height: 24px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .faq-item__btn:focus-visible {
    outline: 2px solid var(--yellow-500);
    outline-offset: 3px;
  }
  .faq-item__icon {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--charcoal-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--yellow-500);
    transition: transform 0.3s ease;
  }
  .is-open .faq-item__icon {
    transform: rotate(45deg);
  }
  .faq-item__a {
    margin: 0;
    padding: 0 20px 20px;
    font-size: 15px;
    line-height: 24px;
    color: var(--silver-gray);
    animation-duration: 0.4s;
  }
</style>
