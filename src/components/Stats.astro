---
import { landing } from '@/data';
---

<div class="stats-wrap">
  <dl class="stats rv">
    {landing.stats.map(({ value, label, highlight }) => (
      <div class="stat">
        <dt class="stat__label">{label}</dt>
        <dd class:list={['stat__value', { 'stat__value--accent': highlight }]}>{value}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .stats-wrap {
    position: relative;
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter) 56px;
  }
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--jet-gray);
    border-radius: var(--r-card);
    background: var(--ink-black);
  }
  /* El valor va primero visualmente; en el DOM el término precede a la definición. */
  .stat {
    padding: 18px 12px;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .stat:not(:last-child) {
    border-right: 1px solid var(--jet-gray);
  }
  .stat__value {
    margin: 0;
    font-size: clamp(24px, 3.4vw, 40px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .stat__value--accent {
    color: var(--yellow-500);
  }
  .stat__label {
    font-size: 12px;
    line-height: 16px;
    color: var(--dusty-gray);
  }
</style>
