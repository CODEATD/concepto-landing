---
/** Layout para páginas secundarias (privacidad, 404): cabecera, contenido legible y pie. */
import Base from './Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

type Props = Parameters<typeof Base>[0];
---

<Base {...Astro.props}>
  <Header />
  <main class="simple">
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .simple {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px var(--gutter) 80px;
    color: var(--light-gray);
    font-size: 16px;
    line-height: 1.7;
  }
  .simple :global(h1) {
    margin: 0 0 24px;
    color: var(--white);
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .simple :global(h2) {
    margin: 40px 0 12px;
    color: var(--white);
    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
  }
  .simple :global(p),
  .simple :global(ul) {
    margin: 0 0 16px;
  }
</style>
